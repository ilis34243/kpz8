                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('every hall carries its events array', function () { const data = pm.response.json().data; pm.expect(data).to.be.an('array'); data.forEach((hall) => pm.expect(hall.events).to.be.an('array')); });"
