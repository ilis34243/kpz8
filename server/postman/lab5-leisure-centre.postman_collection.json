{
  "info": {
    "name": "Leisure centre API (lab 5)",
    "description": "CRUD + JOIN tests for halls, clients, events, event_registrations, hall_rentals and feedback endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runTs')) { pm.collectionVariables.set('runTs', String(Date.now())); }"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/v1"
    },
    {
      "key": "runTs",
      "value": ""
    },
    {
      "key": "hallId",
      "value": ""
    },
    {
      "key": "clientId",
      "value": ""
    },
    {
      "key": "eventId",
      "value": ""
    },
    {
      "key": "rentalId",
      "value": ""
    },
    {
      "key": "registrationId",
      "value": ""
    },
    {
      "key": "feedbackId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Halls",
      "item": [
        {
          "name": "POST /halls - create",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/halls",
              "host": ["{{baseUrl}}"],
              "path": ["halls"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Studio {{runTs}}\",\n  \"capacity\": 20,\n  \"description\": \"Created from Postman collection\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('hall saved and id captured', function () { const d = pm.response.json().data; pm.expect(d.name).to.include('Postman Studio'); pm.collectionVariables.set('hallId', d.id); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /halls - list with joined events",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
