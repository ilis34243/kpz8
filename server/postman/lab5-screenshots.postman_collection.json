    {
      "name": "01 — POST /hall-rentals (create, JOIN)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"hall_id\": 1,\n  \"client_id\": 1,\n  \"start_datetime\": \"2027-03-01T14:00:00.000Z\",\n  \"end_datetime\": \"2027-03-01T16:00:00.000Z\",\n  \"total_cost\": 450.50,\n  \"status\": \"RESERVED\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/hall-rentals",
          "host": ["{{baseUrl}}"],
          "path": ["hall-rentals"]
        },
        "description": "КАДР 01-rental-create.png: зліва видно POST-запит з hall_id/client_id, справа — 201 Created і у відповіді вкладені об'єкти hall та client (а не тільки id)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const r = pm.response.json();",
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.test('hall вкладений, а не лише hall_id', () => {",
              "  pm.expect(r.data.hall).to.be.an('object');",
              "  pm.expect(r.data.hall.name).to.eql('Craft Studio');",
              "});",
              "pm.test('client вкладений', () => {",
              "  pm.expect(r.data.client.full_name).to.eql('Anna Kovalchuk');",
              "});",
              "pm.collectionVariables.set('newRentalId', r.data.id);"
            ]
          }
        }
      ],
      "response": []
    },
