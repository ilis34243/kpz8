NODE_ENV=dev
PORT=4000

# PostgreSQL: у dev-режимі контейнер db_boilerplate слухає хост-порт 8432
PG_HOST=localhost
PG_PORT=8432
POSTGRES_USER=walter
POSTGRES_PASSWORD=change-me
POSTGRES_DB=boilerplate

# JWT: термін дії токена 15 хвилин, тому клієнт оновлює його через /v1/auth/login
JWT_SECRET=change-me
JWT_EXPIRATION=15m
